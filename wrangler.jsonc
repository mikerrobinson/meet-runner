{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swim-starts",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "assets": {
    "binding": "ASSETS",
  },
  // "routes": [
  //   {
  //     "pattern": "swimstarts.com/*",
  //     "zone_name": "swimstarts.com",
  //   },
  // ],
  // Server-side backup of meets. `wrangler dev` spins up a local copy
  // automatically; before deploying, run `npx wrangler d1 create swim-starts`
  // and paste the returned id below. The app works fully offline without it —
  // only the sync buttons go quiet.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swim-starts",
      "database_id": "a2368661-bd05-41e8-b9d4-7a6e85816c7e",
    },
  ],
  // Optional shared secret. Set it with
  // `npx wrangler secret put SYNC_TOKEN` to stop anyone else from reading or
  // writing your meets, then enter the same value under Sync in the app.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
